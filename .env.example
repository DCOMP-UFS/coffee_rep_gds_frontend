# URL base da API, terminando em /api e sem barra final.
# Desenvolvimento: backend NestJS local.
VITE_API_URL=http://localhost:8080/api

# Produção: sem VITE_API_URL, o build usa https://api-gestao-salas.vercel.app/api.
# Para outra API, configure a variável no projeto da Vercel e faça um novo deploy.
